<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textVie_pasek_tytulowy"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:text="Pasek tytułowy"
        android:gravity="center"
        android:background="#40C4FF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/textVie_stopka"
        android:layout_width="0dp"
        android:layout_height="230dp"
        android:background="#40C4FF"
        android:gravity="center"
        android:text="Pasek tytułowy"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
         />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/textVie_pasek_tytulowy"
        app:layout_constraintBottom_toTopOf="@id/textVie_stopka"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal">
        <ImageView
            android:id="@+id/imageView_01"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:src="@drawable/mini_01"
            />

            <ImageView
                android:id="@+id/imageView_02"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:src="@drawable/mini_01" />

            <ImageView
                android:id="@+id/imageView_03"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:src="@drawable/mini_01"
                />
            <ImageView
                android:id="@+id/imageView_04"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:src="@drawable/mini_01"
                />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>