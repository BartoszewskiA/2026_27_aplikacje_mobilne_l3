<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <EditText
        android:id="@+id/editText_dane"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:textSize="30sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="30dp"
        android:hint="Odległość w Km"
        android:inputType="numberDecimal"
        />
    <EditText
        android:id="@+id/editText_wynik"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="30sp"
        app:layout_constraintLeft_toLeftOf="@id/editText_dane"
        app:layout_constraintRight_toRightOf="@id/editText_dane"
        app:layout_constraintTop_toBottomOf="@id/editText_dane"
        android:layout_marginTop="30dp"
        android:hint="wynik"
        android:focusable="false"
        android:cursorVisible="false"
        />
    <Button
        android:id="@+id/btn_mile_angielskie"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Mile angielskie"
        android:textSize="28sp"
        app:layout_constraintLeft_toLeftOf="@id/editText_dane"
        app:layout_constraintRight_toRightOf="@id/editText_dane"
        app:layout_constraintTop_toBottomOf="@id/editText_wynik"
        android:layout_marginTop="30dp"/>
    <Button
        android:id="@+id/btn_mile_morskie"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Mile morskie"
        android:textSize="28sp"
        app:layout_constraintLeft_toLeftOf="@id/editText_dane"
        app:layout_constraintRight_toRightOf="@id/editText_dane"
        app:layout_constraintTop_toBottomOf="@id/btn_mile_angielskie"
        android:layout_marginTop="30dp"/>
    <Button
        android:id="@+id/btn_mile_amerykanskie"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Mile amerykańskie"
        android:textSize="28sp"
        app:layout_constraintLeft_toLeftOf="@id/editText_dane"
        app:layout_constraintRight_toRightOf="@id/editText_dane"
        app:layout_constraintTop_toBottomOf="@id/btn_mile_morskie"
        android:layout_marginTop="30dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>