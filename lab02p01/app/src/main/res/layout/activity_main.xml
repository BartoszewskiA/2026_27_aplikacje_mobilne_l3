<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_verical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.66"
        />

<TextView
    android:id="@+id/tv_baner"
    android:layout_width="0dp"
    android:layout_height="120dp"
    android:text="To jest miejsce\nna twoją reklamę"
    android:textSize="30sp"
    android:background="#3F51B5"
    android:textColor="#64F2FF"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintRight_toRightOf="parent"
    android:gravity="center_vertical|right"
    android:padding="5dp"
    />

    <TextView
        android:id="@+id/tv_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LOGIN:"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_baner"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="40dp"
        />
    <EditText
        android:id="@+id/et_loin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_login"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="20dp"
        android:textSize="22sp"
        android:hint="Login"
        />

    <TextView
        android:id="@+id/tv_pin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PIN:"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_loin"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="40dp"
        />
    <EditText
        android:id="@+id/et_pin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_pin"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="20dp"
        android:textSize="22sp"
        android:hint="Wprowadź PIN"
        android:inputType="numberPassword"
        />

    <Button
        android:id="@+id/btn_login"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="LOGIN"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/gl_verical"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="20dp"
        android:padding="20dp"
        android:textSize="30sp"
        android:backgroundTint="#536DFE"
        android:layout_marginLeft="20dp"/>

    <Button
        android:id="@+id/btn_cancel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="Cancel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/gl_verical"
        app:layout_constraintTop_toTopOf="@id/btn_login"
        android:layout_marginBottom="20dp"
        android:padding="20dp"
        android:textSize="25sp"
        android:backgroundTint="#536DFE"
        android:layout_marginRight="20dp"/>



</androidx.constraintlayout.widget.ConstraintLayout>